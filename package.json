{
  "name": "mini-genius",
  "version": "3.4.0",
  "description": "Mini Genius HR Recruitment App — Windows Desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.recruit.minigenius",
    "productName": "Mini Genius",
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "www/img/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ],
    "directories": { "output": "dist" },
    "artifactName": "mini-genius-windows-${version}.exe"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  }
}
